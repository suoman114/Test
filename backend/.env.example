# Bitbucket Server / Data Center 연동 설정
# 실제 값은 backend/.env 에 복사해서 채운다 (.env 는 커밋 금지)

# Bitbucket 베이스 URL (예: https://bitbucket.mycorp.com)
BITBUCKET_BASE_URL=https://bitbucket.example.com

# 패키지 repo들이 모여 있는 project key
BITBUCKET_PROJECT_KEY=PKG

# 서비스 계정 Personal Access Token (Repo read/write 권한)
BITBUCKET_TOKEN=changeme

# repo 루트 기준 tar 파일 경로 (버전은 git tag로 식별)
PACKAGE_TAR_PATH=package.tar

# 사이트로 노출할 repo slug 필터 (정규식, 비우면 전체)
REPO_SLUG_FILTER=

# CORS 허용 오리진 (프론트엔드 주소)
CORS_ORIGINS=http://localhost:3000
